{
  "name": "mails-bot-api",
  "version": "0.1.0",
  "description": "Mails Bot — NestJS API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "seed:templates": "ts-node -r tsconfig-paths/register src/scripts/seed-templates.ts",
    "migrate:mailbox": "ts-node -r tsconfig-paths/register src/scripts/migrate-mailbox.ts",
    "migrate:hotel-mailbox": "ts-node -r tsconfig-paths/register src/scripts/migrate-hotel-mailbox.ts",
    "clone:db": "ts-node -r tsconfig-paths/register src/scripts/clone-db.ts",
    "migrate:unread": "ts-node -r tsconfig-paths/register src/scripts/mark-unread.ts",
    "webhooks:register": "ts-node -r tsconfig-paths/register src/scripts/register-webhooks.ts",
    "webhooks:list": "ts-node -r tsconfig-paths/register src/scripts/list-webhooks.ts",
    "tunnel": "bash scripts/dev-tunnel.sh"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.3",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/schedule": "^6.1.3",
    "axios": "^1.17.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "mongoose": "^8.4.0",
    "openai": "^6.45.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
