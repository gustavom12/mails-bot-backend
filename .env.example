# App
NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mails-bot

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# AES encryption (for OAuth tokens) — must be exactly 32 chars
# Exactamente 32 caracteres (AES-256)
ENCRYPTION_KEY=change-this-32-char-secret-key!!

# Microsoft Graph (Etapa 2)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback

# Aurinko
AURINKO_CLIENT_ID=
AURINKO_CLIENT_SECRET=
AURINKO_REDIRECT_URI=http://localhost:3001/api/aurinko/callback
AURINKO_SIGNING_SECRET=   # Copiarlo desde app.aurinko.io → tu app → Signing Secret

# Frontend
FRONTEND_URL=http://localhost:3000

# OpenAI — módulo de IA (triage de emails + respuestas sugeridas)
OPENAI_API_KEY=
# Modelo por defecto: gpt-4o (el de mayor calidad de propósito general).
# Podés sobreescribirlo con otro modelo disponible en tu cuenta si preferís.
OPENAI_MODEL=gpt-4o

# AWS S3 (Etapa 2)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Clasificación de mails internos (transaccionales, promocionales, spam)
# Nombre del estado del kanban al que se envían; si el tenant no tiene un
# estado activo con este nombre, la clasificación se omite.
INTERNAL_STATE_NAME=Internos
# Confianza mínima (0-1) que la IA debe declarar para archivar como interno.
INTERNAL_MIN_CONFIDENCE=0.95
